menu "Flight Controller Settings"

    config SEND_UPDATE_INTERVAL_MS
        int "Send Update Interval (ms)"
        default 5000
        help
         "Interval in milliseconds to send updates to the base station over lora"

    config WAYPOINT_REACHED_RADIUS_M
        int "Waypoint reached radius (meters)"
        range 5 500
        default 30
        help
          "Distance in meters within which the current waypoint is considered reached
          and the flight controller advances to the next waypoint."

    config RUDDER_SERVO_MIN
        int "Rudder servo minimum value"
        range -100 -1
        default -100
        help
          "Minimum (full left) servo control value for the rudder. Adjust to match the
          physical servo travel limit. Must be in range [-100, -1]."

    config RUDDER_SERVO_MAX
        int "Rudder servo maximum value"
        range 1 100
        default 100
        help
          "Maximum (full right) servo control value for the rudder. Adjust to match the
          physical servo travel limit. Must be in range [1, 100]."

    config ALTITUDE_SMOOTHING_SAMPLES
        int "Altitude smoothing sample count"
        range 1 50
        default 5
        help
          "Number of recent barometer-derived altitude readings averaged together
          before being used for altitude hold. Higher values smooth out sensor
          noise at the cost of a slower response to real altitude changes."

    config ROLL_SMOOTHING_SAMPLES
        int "Roll angle smoothing sample count"
        range 1 50
        default 5
        help
          "Number of recent gyroscope roll readings averaged together before
          being used for aileron control."

    config PITCH_SMOOTHING_SAMPLES
        int "Pitch angle smoothing sample count"
        range 1 50
        default 5
        help
          "Number of recent gyroscope pitch readings averaged together before
          being used for elevator/pitch control."

    config HEADING_SMOOTHING_SAMPLES
        int "Compass heading smoothing sample count"
        range 1 50
        default 5
        help
          "Number of recent magnetometer heading readings averaged together
          before being used for rudder control."

endmenu